# Se despliega como .htaccess en la raíz del docroot del subdominio.
#
# La webapp vanilla es una SPA con router de hash (#/flashcards), así que no
# necesita reescrituras: el servidor solo ve "/". Lo que sí hace falta es
# controlar el caché, porque un service worker mal cacheado deja a la gente
# clavada en una versión vieja.

<IfModule mod_headers.c>
  # NUNCA cachear el service worker: es el que decide qué se actualiza.
  <Files "sw.js">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </Files>

  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # El contenido de estudio y el JS de la webapp no llevan hash en el nombre,
  # así que un caché largo obligaría a bump manual. Una hora es el compromiso.
  <FilesMatch "\.(js|css|json)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>

  <FilesMatch "\.(png|jpg|jpeg|svg|webp|ico|woff2?)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

# Sin listados de directorio.
Options -Indexes
