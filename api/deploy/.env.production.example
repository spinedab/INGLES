# Plantilla del entorno de producción en la Mac Studio.
# Copiar a deploy/.env.production y rellenar. Ese archivo está gitignorado.
#
#   cp deploy/.env.production.example deploy/.env.production
#   grep '^TOKEN=' ~/.local/share/apps/gemma-proxy/.env   # copiar valor a GEMMA_API_TOKEN
#   chmod 600 deploy/.env.production

# ── Proveedor de IA ────────────────────────────────────────────────────────
# "gemma" usa el Gemma4 local de la Mac (Ollama) vía gemma-proxy — sin coste,
# sin salir de la infraestructura propia. Es EL MISMO gemma-proxy que ya usan
# otros proyectos (Confessio, etc.), solo que aquí se llama por el host
# directamente y NO por la URL pública (https://gemma2.apicloud.lat): esa
# daría una vuelta por Cloudflare y dependería de que el túnel esté arriba.
INGLES_PROVIDER=gemma
GEMMA_API_URL=http://host.docker.internal:11436
GEMMA_API_TOKEN=cambiar-esto
GEMMA_MODEL=gemma4:e4b

# ── Sesiones (Redis propio del proyecto, sin publicar puerto) ─────────────
INGLES_REDIS_URL=redis://redis:6379/0

# ── Operación ──────────────────────────────────────────────────────────────
# Token bearer que deben mandar los clientes (mobile/webapp). Vacío = sin auth
# (aceptable solo mientras el endpoint no sea de conocimiento público).
INGLES_API_TOKEN=
INGLES_RATE_LIMIT_PER_MIN=60
# CORS: restringir a los orígenes reales cuando la webapp/mobile build final
# esté fijada (ej. https://ingles.apicloud.lat,https://spinedab.github.io).
INGLES_CORS_ORIGINS=*
