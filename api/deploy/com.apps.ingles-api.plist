<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.apps.ingles-api</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/macstudio/.local/share/apps/ingles-api/boot.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/macstudio/.local/share/apps/ingles-api</string>
    <!-- Sin esto el agente no encuentra `docker`: launchd no hereda el PATH de
         la sesión interactiva, así que boot.sh esperaba en vano al runtime y
         moría con «Docker no responde tras 5 minutos» en cada reinicio.
         Mismo bloque que com.apps.emoji-generator. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <!-- Red de seguridad: reintenta si boot.sh sale con error (p. ej. si algún
         día el runtime de Docker tarda más que su espera). La avería del 28 ago
         2026 («Docker no responde tras 5 minutos») NO era eso sino el PATH de
         arriba; esto queda para que un fallo transitorio no deje el tutor caído
         hasta que alguien entre a mano. SuccessfulExit=false relanza SOLO en
         salida con error, así que cuando el stack sube, launchd deja de insistir. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>StandardOutPath</key>
    <string>/Users/macstudio/Library/Logs/apps-ingles-api.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/macstudio/Library/Logs/apps-ingles-api.err.log</string>
</dict>
</plist>
