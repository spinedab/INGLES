<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.apps.ingles-api</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/macstudio/.local/share/apps/ingles-api/boot.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/macstudio/.local/share/apps/ingles-api</string>
    <key>RunAtLoad</key>
    <true/>
    <!-- Reintenta si boot.sh falla. Sin esto, si colima tarda más que la espera
         de boot.sh (pasó el 28 ago 2026: «Docker no responde tras 5 minutos»,
         exit 1) el tutor se queda caído hasta que alguien entra a mano.
         SuccessfulExit=false relanza SOLO en salida con error, así que cuando
         el stack por fin sube, launchd deja de insistir. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>StandardOutPath</key>
    <string>/Users/macstudio/Library/Logs/apps-ingles-api.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/macstudio/Library/Logs/apps-ingles-api.err.log</string>
</dict>
</plist>
