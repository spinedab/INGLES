<?xml version="1.0" encoding="UTF-8"?>
<!--
  Manifiesto de la app web para Samsung Tizen TV.

  El id de aplicación son dos partes: el `package` de 10 caracteres
  alfanuméricos (arbitrario pero fijo de por vida: cambiarlo crea una app
  distinta a ojos del sistema) y el nombre, separados por punto.

  required_version 6.0 fija el mínimo en Tizen 6.0 (televisores de 2021 en
  adelante), que embarca Chromium 76. Ese es el motor contra el que está
  escrita la capa de compatibilidad de tv.css. Bajar de aquí obligaría a
  renunciar también a grid y a las propiedades personalizadas.
-->
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://ingles.nexocloud.co/tv"
        version="1.0.0"
        viewmodes="maximized">
  <tizen:application id="INGLESapp0.TutorIngles"
                     package="INGLESapp0"
                     required_version="6.0"/>
  <tizen:profile name="tv"/>
  <name>Tutor Inglés IA</name>
  <description>Vocabulario con repeticion espaciada, lectura graduada, listening y gramatica.</description>
  <author email="dnework.col@gmail.com">Santiago Pineda Botero</author>
  <content src="index.html"/>
  <icon src="icon.png"/>
  <tizen:setting screen-orientation="landscape"
                 context-menu="disable"
                 background-support="disable"
                 encryption="disable"
                 hwkey-event="enable"/>
  <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>
</widget>
